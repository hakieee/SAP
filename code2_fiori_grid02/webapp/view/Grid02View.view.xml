<mvc:View controllerName="code2.fiori.grid02.code2fiorigrid02.controller.Grid02View"
    xmlns:t="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <t:Table
            id = "countrySet"   
            rows="{/countrySet}"
            selectionMode="Single"
            selectionBehavior="RowOnly"
            paste="onPaste"
            ariaLabelledBy="title">
             <t:extension>        
                <OverflowToolbar style="Clear">
                    <Label  text = "Country" 
                            design="Bold" />
                    <Input  id = "ICountry"
                            width = "5rem"
                            placeholder="국가명"
                            showClearIcon="true" />
                    <ToolbarSpacer width = "3rem" />
                    <Label  text = "Area" 
                            design="Bold" />
                    <Input  id = "IArea"
                            width = "5rem"
                            placeholder="지역"
                            showClearIcon="true" />
                    <Button text = "Search" 
                            icon = "sap-icon://search" 
                            press = "onSearch"/>
                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="8rem">
                    <Label text="Country Name" />
                    <t:template>
                        <Text text="{Country}" wrapping="false" /> 
                        
                    </t:template>
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Capital" />
                    <t:template>
                        <Text text="{Capital}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Area" />
                    <t:template>
                        <Text text="{Area}" wrapping="false"/>                    
                    </t:template>   
                </t:Column>



                

                
                
                
            </t:columns>
		</t:Table>




        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~ 실습 ~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->


        <t:Table
            id = "Materials"   
            rows="{Mat>/matSet}"
            selectionMode="Single"
            selectionBehavior="RowOnly"
            paste="onPaste"
            ariaLabelledBy="title">
             <t:extension>        
                <OverflowToolbar style="Clear">
                    <Label  text = "Material" 
                            design="Bold" />
                    <Input  id = "IMatnr"
                            width = "5rem"
                            placeholder="Material"
                            showClearIcon="true" />
                    <ToolbarSpacer width = "3rem" />
                    <Label  text = "Maktx" 
                            design="Bold" />
                    <Input  id = "IMaktx"
                            width = "5rem"
                            placeholder="Maktx"
                            showClearIcon="true" />
                    <Button text = "Search" 
                            icon = "sap-icon://search" 
                            press = "onSearch"/>
                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="8rem">
                    <Label text="Matnr" />
                    <t:template>
                        <Text text="{Mat>Matnr}" wrapping="false" /> 
                        
                    </t:template>
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Maktx" />
                    <t:template>
                        <Text text="{Mat>Maktx}" wrapping="false" />
                    </t:template>
                    </t:Column>

                <t:Column width="10rem">
                    <Label text="Werks" />
                    <t:template>
                        <Text text="{Mat>Werks}" wrapping="false"/>                    
                    </t:template>   

                
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Netprice" />
                    <t:template>
                        <Text text="{Mat>Netprice}" wrapping="false"/>                    
                    </t:template>   

                
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Curr" />
                    <t:template>
                        <Text text="{Mat>Curr}" wrapping="false"/>                    
                    </t:template>   

                
                </t:Column>


            </t:columns>
		</t:Table>

    </Page>
</mvc:View>