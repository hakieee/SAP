<mvc:View controllerName="code2.fiori.grid01.code2fiorigrid01.controller.Grid01View"
    xmlns:t="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <t:Table
            rows="{/airSet}"
            selectionMode="Single"
            selectionBehavior="Row"
            paste="onPaste"
            ariaLabelledBy="title">
             <t:extension>   <!-- selectionBehavior에서 Row 자리에는 Row, RowOnly, RowSelecter 가 들어올수잇는데 어떤식으로 선택을 할거냐를 선택을 할 수 잇음 -->      
                <OverflowToolbar style="Clear">
                    <Title id="title" text="AirLine List"/>
                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column width="6rem">
                    <Label text="Airline Code" />
                    <t:template>
                        <!-- {airSet/Carrid} 안해도 되는 이유 : 이미 rows의 주인은 airSet으로 이미 언급이 되서 그냥 써도됨 -->
                        <Text text="{Carrid}" wrapping="false" /> 
                        
                    </t:template>
                </t:Column>

                <t:Column width="8rem">
                    <Label text="AirLine Name" />
                    <t:template>
                        <Text text="{Carrname}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Price" />
                    <t:template>
                        <u:Currency value="{Price}" currency="{Currency}"/>                    
                </t:template>   <!-- Price에 왜 원화, 동, 엔 에는 왜 .00 이 안붙을까?
                                     - > 걔네만 안나옴
                                     85000원을 예로 들면 시스템에서는 850.00 으로 인식함 근데 여기서 위에 셋이면 소숫점을 알아서 옮김 그니까 절대 가격을 수정하지마라
                                    정리 : SAP 안에서 다 알아서 하는 함수 잇으니까 신경 ㄴ -->
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Price" />
                    <t:template>
                        <Text text="{
                            parts:[{path:'Price'},{path:'Currency'}],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true }
                            }" wrapping="false" />                
                    </t:template>
                    <!-- parts 는 여러 개의 값을 묶어서 하나의 속성에 바인딩할 때 쓰는 거
                    type: 'sap.ui.model.type.Currency' : 결과 뒤에 통화 코드도 같이 표시 
                    formatOptions: {showMeasure: true } : 단위를 같이 보여줘 말아(ex USD냐 KRW냐) false면 숫자만 -->

                </t:Column>

                <t:Column width="7rem">
                    <Label text="Currency Code" />
                    <t:template>
                        <Text text="{Currency}" wrapping="false" />
                    </t:template>
                </t:Column>
                
                
            </t:columns>
		</t:Table>



        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~ 실습~~~~~~~~~~~~~~~~~~~~~~~~ -->
        <!-- 이거 겁나 어려웟으니까 제발 공부 ㄱ -->


        <t:Table
            rows="{Mat>/matSet}"
            selectionMode="Single"
            selectionBehavior="Row"
            paste="onPaste"
            ariaLabelledBy="title">
             <t:extension>   <!-- selectionBehavior에서 Row 자리에는 Row, RowOnly, RowSelecter 가 들어올수잇는데 어떤식으로 선택을 할거냐를 선택을 할 수 잇음 -->      
                <OverflowToolbar style="Clear">
                    <Title id="Topic" text="MatSet"/>
                </OverflowToolbar>
            </t:extension>

            <t:columns>
                <t:Column width="6rem">
                    <Label text="Material" />
                    <t:template>
                        <Text text="{Mat>Matnr}" wrapping="false" /> 
                    </t:template>
                </t:Column>

                <t:Column width="8rem">
                    <Label text="Mat.Desc" />
                    <t:template>
                        <Text text="{Mat>Maktx}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Plant" />
                    <t:template>
                        <Text text="{Mat>Werks}"/>                    
                    </t:template>   
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Net Price" />
                    <t:template>
                        <Text text="{
                            parts:[{path:'Mat>Netprice'},{path:'Mat>Curr'}],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true }
                            }" wrapping="false" />                     
                    </t:template>   
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Curr" />
                    <t:template>
                        <Text text="{Mat>Curr}" />                    
                    </t:template>   
                </t:Column>

                
            </t:columns>
		</t:Table>

        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~ 실습~~~~~~~~~~~~~~~~~~~~~~~~ -->

        <t:Table
            rows="{Order>/orderSet}"
            selectionMode="Single"
            selectionBehavior="RowSelector"
            paste="onPaste"
            ariaLabelledBy="title">
             <t:extension>   
                <OverflowToolbar style="Clear">
                    <Title id="Top" text="Order List"/>
                </OverflowToolbar>
            </t:extension>

            <t:columns>
                <t:Column width="6rem">
                    <Label text="Order No" />
                    <t:template>
                        <Text text="{Order>Ordno}" wrapping="false" /> 
                    </t:template>
                </t:Column>

                <t:Column width="8rem">
                    <Label text="Airline" />
                    <t:template>
                        <Text text="{Order>Carrid}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column width="10rem">
                    <Label text="FlightNo" />
                    <t:template>
                        <Text text="{Order>Connid}"/>                    
                    </t:template>   
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Seats" />
                    <t:template>
                        <Text text="{Order>Seats}"/>                    
                    </t:template>   
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Amount" />
                    <t:template>
                        <Text text="{
                            parts:[{path:'Order>Amount'},{path:'Order>Curr'}],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {showMeasure: true }
                            }" wrapping="false" />                     
                    </t:template>   
                </t:Column>

                <t:Column width="10rem">
                    <Label text="Curr" />
                    <t:template>
                        <Text text="{Order>Curr}" />                    
                    </t:template>   
                </t:Column>

                
            </t:columns>
		</t:Table>
    </Page>
</mvc:View>